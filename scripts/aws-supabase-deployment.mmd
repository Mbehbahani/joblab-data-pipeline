flowchart TD
    DEV([💻 Developer / CI])
    SETUP[/⚙️ aws-setup-supabase.ps1\nProvision AWS infrastructure/]
    DEPLOY[/🐳 deploy-supabase.ps1\nBuild and push container/]
    MANUAL[/🧪 run-manual.ps1\nTrigger one-off ECS task/]

    S3[(🪣 S3 Bucket\nSnapshots / artifacts)]
    ECR[(📦 ECR Repository\nContainer images)]
    LOGS[(📜 CloudWatch Logs)]
    SSM[(🔐 SSM Parameter Store\nSupabase secrets)]

    IAM{{🛡️ IAM Roles\nTaskExecution / Task / Scheduler}}
    ECSC{{☁️ ECS Cluster\nFargate}}
    TD[/📋 ECS Task Definition\npython -u src/orchestrate/run_weekly.py/]
    SCH([⏰ EventBridge Scheduler\nDaily 2 AM Europe/Berlin])
    RUN([🚀 ECS Fargate Task])
    SUPA[(🟢 Supabase)]
    APP[[🐍 Weekly Pipeline\nsrc/orchestrate/run_weekly.py]]

    DEV --> SETUP
    DEV --> DEPLOY
    DEV --> MANUAL

    SETUP --> S3
    SETUP --> ECR
