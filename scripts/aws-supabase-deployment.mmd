    SETUP --> IAM
    SETUP --> ECSC
    SETUP --> TD
    SETUP --> SCH

    DEPLOY --> ECR

    SCH --> RUN
    MANUAL --> RUN
    ECSC --> RUN
    TD --> RUN
    ECR --> RUN
    SSM --> RUN
    IAM --> RUN

    RUN --> APP
    APP --> SUPA
    APP --> S3
    APP --> LOGS

