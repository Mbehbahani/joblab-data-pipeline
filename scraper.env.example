# JobLab Scraper - Self-hosted environment configuration
# Copy to scraper.env and fill in values

# Supabase-compatible REST endpoint. Copy SUPABASE_SERVICE_ROLE_KEY from the
# generated compose .env file. This container joins the `joblab` Docker network.
SUPABASE_URL=http://api-proxy:3000
SUPABASE_SERVICE_ROLE_KEY=PASTE_GENERATED_WRITER_JWT_HERE
DRY_RUN=false
CLEAR_SUPABASE=false
BATCH_SIZE=50

# Local filesystem storage
JOBLAB_DATA_DIR=/opt/joblab/data

# Bedrock embeddings (unchanged - still calls AWS Bedrock for now)
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=